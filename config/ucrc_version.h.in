/**
 * @file ucrc_version.h
 * @brief Define the library version.
 *
 * Meson generates this file.
 */

#ifndef UCRC_VERSION_H_
#define UCRC_VERSION_H_

#define UCRC_VERSION       @VERSION@
#define UCRC_VERSION_MAJOR @MAJOR@
#define UCRC_VERSION_MINOR @MINOR@
#define UCRC_VERSION_PATCH @PATCH@

#define UCRC_VERSION_STRING "@MAJOR@.@MINOR@.@PATCH@"

#endif /* UCRC_VERSION_H_ */
